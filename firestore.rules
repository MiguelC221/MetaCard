rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return getUserData().role == role; }
    function isAdmin() { return isAuth() && hasRole('admin'); }
    function isSeller() { return isAuth() && (hasRole('seller') || hasRole('admin')); }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAuth() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Transactions ─────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      // Solo el backend (Admin SDK) puede escribir transacciones
      allow write: if false;
    }

    // ── Withdraw Codes ───────────────────────────────────────────────────────
    match /withdraw_codes/{codeId} {
      // El usuario puede crear su propio código de retiro
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // El usuario solo puede leer sus propios códigos
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Solo admin puede marcar como usado o eliminar
      allow update, delete: if isAdmin();
    }

    // ── Cards ────────────────────────────────────────────────────────────────
    match /cards/{cardUid} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Products ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true; // público
      allow write: if isSeller();
    }

    // ── Market / Orders ──────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // ── Convenios ────────────────────────────────────────────────────────────
    match /convenios/{convenioId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Referrals ────────────────────────────────────────────────────────────
    match /referrals/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow write: if false; // solo Admin SDK
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false; // solo Admin SDK
    }

    // ── Support Tickets ──────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
    }
  }
}
